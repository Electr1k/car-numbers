ENV=development

# --- HTTP ---
HTTP_ADDRESS=""
HTTP_PORT=8080
CORE_HTTP_FORWARD_PORT=8081
HTTP_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# --- Логи ---
LOG_LEVEL=debug
LOG_FORMAT=json

# --- База ---
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=postgres

DATABASE_URL=postgres://postgres:postgres@core-db:5432/postgres?sslmode=disable
DATABASE_MIGRATIONS_PATH=./migrations

PLATE_URL=http://data-api:8080
PLATE_TIMEOUT=10s
