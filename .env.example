# Переменные для docker-compose.prod.yaml; секреты сервисов — в их собственных .env
DOMAIN=nomerograf.ru

# База: 127.0.0.1 — только с сервера (SSH-туннель), 0.0.0.0 — открыть наружу
DB_BIND=127.0.0.1
DB_FORWARD_PORT=8989

# Grafana (docker-compose.monitoring.yaml): 127.0.0.1 — только с сервера (SSH-туннель), 0.0.0.0 — открыть в сеть
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001