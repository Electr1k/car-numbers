ENV=prod

# --- HTTP ---
HTTP_ADDRESS=""
HTTP_PORT=8080
HTTP_FORWARD_PORT=80
HTTP_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s

JWT_SECRET=abcdefgh

# --- Логи ---
LOG_LEVEL=debug
LOG_FORMAT=json

# --- База ---
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=postgres

DATABASE_URL=postgres://<DATABASE_USER>:<DATABASE_PASSWORD>@data-db:${DATABASE_PORT}/<DATABASE_DATABASE>?sslmode=disable
DATABASE_MIGRATIONS_PATH=./migrations

# --- Провайдер autonomera777 ---
AUTONOMERA_BASE_URL=https://autonomera777.ru
AUTONOMERA_BATCH_SIZE=20
# Насколько глубоко по дате публикации заходит регулярный прогон
AUTONOMERA_IMPORT_DEPTH=72h

# --- Провайдер gosnomeru ---
GOSNOMERU_BASE_URL=https://gosnomeru.com
GOSNOMERU_IMPORT_DEPTH=72h

# --- Провайдер anomera ---
ANOMERA_BASE_URL=https://anomera6.ru
ANOMERA_IMPORT_DEPTH=72h

# --- Кроны ---
# Пустая спека выключает крон
CRON_IMPORT_AUTONOMERA_ACTIVE_OFFERS=0 * * * *
CRON_IMPORT_AUTONOMERA_ARCHIVE_OFFERS=30 * * * *
CRON_IMPORT_GOSNOMERU_OFFERS=0 * * * *
CRON_IMPORT_ANOMERA_OFFERS=0 * * * *
CRON_SYNC_ACTIVE_OFFERS=0 3 * * *